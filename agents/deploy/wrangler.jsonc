{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "content-factory",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },

  // One Worker fronts the whole mesh: hostname → container class. The Worker
  // also owns the D1 binding and serves the secret-gated /d1/query proxy the
  // containers' StoreDb driver calls back into (containers get no bindings —
  // pattern + latency measured in references/cloudflare/d1-container).
  // jackzhaojin.com is the live brand. The *.xpri.ai routes still resolve in
  // parallel and are PENDING MANUAL INFRA TEARDOWN — when retiring xpri, delete
  // the 5 xpri.ai entries below and redeploy (deploy between runs, not during).
  "routes": [
    { "pattern": "content-factory.jackzhaojin.com", "custom_domain": true },
    { "pattern": "content-factor-dash.jackzhaojin.com", "custom_domain": true },
    { "pattern": "content-factory-eval.jackzhaojin.com", "custom_domain": true },
    { "pattern": "content-factory-gen.jackzhaojin.com", "custom_domain": true },
    { "pattern": "content-factory-migrate.jackzhaojin.com", "custom_domain": true },

    { "pattern": "content-factory.xpri.ai", "custom_domain": true },
    { "pattern": "content-factor-dash.xpri.ai", "custom_domain": true },
    { "pattern": "content-factory-eval.xpri.ai", "custom_domain": true },
    { "pattern": "content-factory-gen.xpri.ai", "custom_domain": true },
    { "pattern": "content-factory-migrate.xpri.ai", "custom_domain": true }
  ],

  "containers": [
    {
      "class_name": "CoordinatorContainer",
      "image": "./docker/coordinator.Dockerfile",
      "image_build_context": "../",
      "max_instances": 1,
      "instance_type": "basic"
    },
    {
      "class_name": "EvalContainer",
      "image": "./docker/eval.Dockerfile",
      "image_build_context": "../",
      "max_instances": 1,
      // standard-1 (1/2 vCPU, 4GiB) OOM/starved mid-eval once the agentic tier
      // engages: chromium + 4 parallel Claude CLI passes. 2 vCPU / 8 GiB holds.
      "instance_type": "standard-3"
    },
    {
      "class_name": "ContentGenContainer",
      "image": "./docker/content-gen.Dockerfile",
      "image_build_context": "../",
      "max_instances": 1,
      // bumped lite→basic: the agentic backend spawns a Claude CLI subprocess for
      // writing (tool-free, far lighter than eval's chromium+4 passes, but lite's
      // 256MiB starves the Node + CLI pair). basic = 1/4 vCPU, 1GiB.
      "instance_type": "basic"
    },
    {
      "class_name": "MigrationContainer",
      "image": "./docker/migration.Dockerfile",
      "image_build_context": "../",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "CoordinatorContainer" },
      { "name": "EVAL", "class_name": "EvalContainer" },
      { "name": "CONTENT_GEN", "class_name": "ContentGenContainer" },
      { "name": "MIGRATION", "class_name": "MigrationContainer" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CoordinatorContainer", "EvalContainer", "ContentGenContainer", "MigrationContainer"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a2a-agents",
      "database_id": "db84ebfc-2132-45ac-902d-7ef7117786e8"
    }
  ],

  // Non-secret config. Secrets (D1_PROXY_SECRET, A2A_MESH_TOKEN, A2A_EDGE_TOKEN,
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET,
  // AUTH_SECRET, CLAUDE_CODE_OAUTH_TOKEN, CLAUDE_ACCOUNT_UUID, CLAUDE_EMAIL,
  // CLAUDE_ORG_UUID, and the OPTIONAL MOONSHOT_API_KEY) via `wrangler secret put`.
  // The CLAUDE_* set feeds eval, content-gen (the agentic writer) AND migration
  // (the sdk backend, the default since 2026-10).
  "vars": {
    "R2_BUCKET": "a2a-agents-artifacts",
    "R2_PUBLIC_BASE": "https://pub-ae7a7d0dbe1049c69ae60848bc58bfbf.r2.dev",
    "R2_ACCOUNT_ID": "957b2690e54ade4c335d8e395c5b69d5",
    "AUTH_ALLOWED_EMAILS": "",
    "MIGRATION_DEFAULT_BACKEND": "dryrun",
    "DALIVE_MCP_URL": "https://jack-mcp-azure-ai-function.azurewebsites.net/api/mcp-streamable",
    // DEFAULT Claude model for sdk runs that don't name one (dashboard "agent
    // default", ad-hoc A2A calls). The daily-loop workflow passes `model`
    // explicitly per run. A Claude Code alias (opus | sonnet | haiku) or a full
    // model id; the run log records the resolved id. Opus tied for best (90) in
    // the 2026-09-08 model assessment, with the fastest migration.
    "CLAUDE_MIGRATION_MODEL": "opus",
    // opencode (Kimi) default model - only used if a MOONSHOT_API_KEY secret is
    // set; no Kimi subscription backs this deployment since 2026-10. Kept so
    // anyone with a Kimi For Coding key can re-enable the backend.
    // "kimi-for-coding" is a moving alias (currently K2.7 Coding). Whatever you
    // set must ALSO exist in docker/opencode-global.jsonc's models map.
    "KIMI_MODEL_ID": "k3"
  }
}
